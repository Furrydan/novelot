{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "target": "es2025",
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "types": [
      "node"
    ],
    "paths": {
      "@assets/*": [
        "./src/assets/*",
      ],
      "@models/*": [
        "./src/models/*"
      ],
    }
  },
  "include": [
    "src/**/*"
  ]
}
